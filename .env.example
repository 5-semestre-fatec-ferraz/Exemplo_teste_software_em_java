# ===================================================================
# Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para '.env' e preencha com suas credenciais reais.
# ===================================================================

# Configurações do Servidor
SERVER_PORT=8089

# Configurações do Banco de Dados
DB_URL=jdbc:mariadb://localhost:3306/gwj2
DB_USERNAME=desenvolvedor
DB_PASSWORD=sua_senha_aqui
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Prefixo e Pacotes
APP_DB_PREFIX=tab_
APP_ENTITY_PACKAGE=com.gwj.model.domain
APP_ENTITIES_PATH=com.gwj.model.domain.entities
